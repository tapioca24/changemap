{
  "name": "changemap",
  "version": "0.0.0",
  "description": "Understand code changes through file dependency maps.",
  "license": "MIT",
  "author": "tapioca24",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tapioca24/changemap.git"
  },
  "bin": {
    "changemap": "dist/cli.mjs"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "scripts": {
    "build": "tsdown && vite build",
    "test": "pnpm build && vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --deny-warnings",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "prepack": "pnpm build",
    "test:pack": "node scripts/pack-smoke.mjs",
    "benchmark:analysis": "node scripts/benchmark-analysis.mjs",
    "benchmark:rendering": "node scripts/benchmark-rendering.mjs",
    "benchmark:layout": "node scripts/benchmark-layout.mjs"
  },
  "dependencies": {
    "build": "^0.1.4",
    "smol-toml": "^1.8.0",
    "typescript-api": "npm:typescript@6.0.2"
  },
  "devDependencies": {
    "@catppuccin/palette": "^1.8.0",
    "@dagrejs/dagre": "^3.1.1",
    "@shikijs/langs": "4.4.3",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^24.13.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@xyflow/react": "^12.11.6",
    "backlog.md": "1.51.0",
    "jsdom": "^30.0.1",
    "oxfmt": "0.67.0",
    "oxlint": "1.82.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "shiki": "^4.4.3",
    "ts-morph": "28.0.0",
    "tsdown": "0.23.0",
    "typescript": "7.0.2",
    "vite": "^8.3.0",
    "vitest": "5.0.0"
  },
  "engines": {
    "node": ">=24.11.0 <25"
  },
  "packageManager": "pnpm@10.33.0"
}
